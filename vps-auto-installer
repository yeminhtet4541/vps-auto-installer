#!/usr/bin/env bash
# VPS Production-ready Auto Installer
# Supports: Ubuntu 20.04 / Ubuntu 22.04 / Debian 11 (and compatible)
# This script is intended to be run as root. It aims to be safe for production use
# by using explicit defaults, validating inputs, creating backups of changed files,
# and keeping operations idempotent where feasible.
# USAGE (recommended):
# 1) Upload to server and run non-interactively with environment variables:
#    DOMAIN=example.com EMAIL=admin@example.com bash vps_prod_installer.sh --full
# 2) Or run interactively:
#    sudo bash vps_prod_installer.sh

set -euo pipefail
export DEBIAN_FRONTEND=noninteractive

#############################
# Configuration defaults
#############################
: ${DOMAIN:=""}
: ${EMAIL:=""}
: ${XRAY_PORT:=10086}
: ${SSH_WS_PORT:=8080}
: ${GOST_PORT:=8080}
: ${DROPBEAR_PORT:=444}
: ${NGINX_HTTP_PORT:=80}
: ${NGINX_HTTPS_PORT:=443}
: ${SOWDNS_INSTALL:=false}
: ${XRAY_UUID:=""}

LOG() { echo -e "[INFO] $*"; }
ERR() { echo -e "[ERROR] $*" >&2; }
BACKUP() { 
  local f="$1"; 
  if [ -f "$f" ]; then
    cp -a "$f" "$f.bak.$(date +%Y%m%d_%H%M%S)" || true
  fi
}

require_root() {
  if [ "$EUID" -ne 0 ]; then
    ERR "This script must be run as root. Use: sudo bash $0"
    exit 1
  fi
}

gen_uuid_if_empty() {
  if [ -z "$XRAY_UUID" ]; then
    if command -v uuidgen >/dev/null 2>&1; then
      XRAY_UUID=$(uuidgen)
    else
      XRAY_UUID=$(cat /proc/sys/kernel/random/uuid)
    fi
    LOG "Generated XRAY UUID: $XRAY_UUID"
  fi
}

detect_os() {
  if [ -f /etc/os-release ]; then
    . /etc/os-release
    case "${ID,,}" in
      ubuntu|debian) LOG "Detected OS: $NAME $VERSION_ID" ;; 
      *) ERR "Unsupported OS: $ID"; exit 1 ;;
    esac
  else
    ERR "Cannot detect OS"; exit 1
  fi
}

apt_update_install() {
  apt-get update -y
  apt-get install -y --no-install-recommends "$@"
}

# -------------------- Security / firewall --------------------
setup_ufw() {
  LOG "Configuring UFW"
  apt_update_install ufw
  ufw default allow outgoing
  ufw default deny incoming
  ufw allow OpenSSH
  ufw allow "$NGINX_HTTP_PORT"/tcp
  ufw allow "$NGINX_HTTPS_PORT"/tcp
  ufw allow "$GOST_PORT"/tcp
  ufw --force enable
}

# -------------------- SSH + Dropbear + gost/ws --------------------
install_ssh_ws() {
  LOG "Installing OpenSSH & Dropbear"
  apt_update_install openssh-server dropbear curl wget git
  systemctl enable --now ssh

  BACKUP /etc/default/dropbear
  sed -i "s/#DROPBEAR_PORT=.*/DROPBEAR_PORT=$DROPBEAR_PORT/" /etc/default/dropbear || true
  sed -i "s/DROPBEAR_EXTRA_ARGS=.*/DROPBEAR_EXTRA_ARGS='-w -g'/" /etc/default/dropbear || true
  systemctl enable --now dropbear

  # install gost for websocket tunneling
  GOST_BIN=/usr/local/bin/gost
  if [ ! -x "$GOST_BIN" ]; then
    LOG "Installing gost binary"
    ARCH=$(dpkg --print-architecture)
    case "$ARCH" in
      amd64) A=amd64;;
      arm64) A=arm64;;
      armhf) A=armv7;;
      *) A=amd64;;
    esac
    URL="https://github.com/ginuerzh/gost/releases/latest/download/gost-linux-$A"
    curl -fsSL -o "$GOST_BIN" "$URL"
    chmod +x "$GOST_BIN"
  fi

  # systemd service
  cat >/etc/systemd/system/gost-ssh-ws.service <<EOF
[Unit]
Description=Gost SSH over WebSocket
After=network.target

[Service]
Type=simple
ExecStart=/usr/local/bin/gost -L=:$GOST_PORT/ws://127.0.0.1:22
Restart=on-failure

[Install]
WantedBy=multi-user.target
EOF
  systemctl daemon-reload
  systemctl enable --now gost-ssh-ws
  LOG "SSH over WebSocket running on path /ws port $GOST_PORT"
}

# -------------------- XRay install (stable release) --------------------
install_xray() {
  LOG "Installing XRay core"
  apt_update_install unzip ca-certificates
  XRAY_BIN=/usr/local/bin/xray
  if [ ! -x "$XRAY_BIN" ]; then
    TMPDIR=$(mktemp -d)
    trap 'rm -rf "$TMPDIR"' EXIT
    ARCH=$(dpkg --print-architecture)
    case "$ARCH" in
      amd64) A=64;;
      arm64) A=arm64;;
      armhf) A=armv7;;
      *) A=64;;
    esac
    URL="https://github.com/XTLS/Xray-core/releases/latest/download/Xray-linux-$A.zip"
    curl -fsSL -o "$TMPDIR/xray.zip" "$URL"
    unzip -q "$TMPDIR/xray.zip" -d "$TMPDIR/xraytmp"
    install -m 755 "$TMPDIR/xraytmp/xray" "$XRAY_BIN"
  fi

  mkdir -p /etc/xray
  BACKUP /etc/xray/config.json
  cat >/etc/xray/config.json <<EOF
{
  "log": {"access":"/var/log/xray/access.log","error":"/var/log/xray/error.log","loglevel":"warning"},
  "inbounds": [
    {
      "port": $XRAY_PORT,
      "protocol": "vless",
      "settings": {"clients":[{"id":"$XRAY_UUID"}],"decryption":"none"},
      "streamSettings": {"network":"ws","wsSettings":{"path":"/xray"}}
    }
  ],
  "outbounds": [{"protocol":"freedom","settings":{}}]
}
EOF
  mkdir -p /var/log/xray
  chown -R root:root /etc/xray

  cat >/etc/systemd/system/xray.service <<EOF
[Unit]
Description=XRay Service
After=network.target

[Service]
User=root
ExecStart=$XRAY_BIN -config /etc/xray/config.json
Restart=on-failure
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
EOF
  systemctl daemon-reload
  systemctl enable --now xray
  LOG "XRay installed and started on port $XRAY_PORT (ws path /xray)"
}

# -------------------- nginx + acme.sh automatic TLS provisioning --------------------
install_nginx_and_acme() {
  if [ -z "$DOMAIN" ] || [ -z "$EMAIL" ]; then
    ERR "DOMAIN and EMAIL must be set to install nginx+TLS. Export DOMAIN and EMAIL or run interactively."
    return 1
  fi
  LOG "Installing nginx and acme.sh"
  apt_update_install nginx socat curl
  systemctl enable --now nginx

  # nginx site config for reverse proxy to XRay ws
  BACKUP /etc/nginx/sites-available/$DOMAIN
  cat >/etc/nginx/sites-available/$DOMAIN <<EOF
server {
  listen $NGINX_HTTP_PORT;
  server_name $DOMAIN;

  location /xray {
    proxy_redirect off;
    proxy_pass http://127.0.0.1:$XRAY_PORT;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";
    proxy_set_header Host $host;
  }

  location /ws {
    proxy_redirect off;
    proxy_pass http://127.0.0.1:$GOST_PORT;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";
    proxy_set_header Host $host;
  }
}
EOF
  ln -sf /etc/nginx/sites-available/$DOMAIN /etc/nginx/sites-enabled/$DOMAIN
  nginx -t && systemctl reload nginx

  # install acme.sh and issue cert
  if [ ! -f /root/.acme.sh/acme.sh ]; then
    curl https://get.acme.sh | sh -s email="$EMAIL" --force
    source /root/.acme.sh/acme.sh.env || true
  fi
  LOG "Issuing certificate for $DOMAIN"
  /root/.acme.sh/acme.sh --issue --nginx -d "$DOMAIN" --force || { ERR "acme issue failed"; return 1; }
  /root/.acme.sh/acme.sh --install-cert -d "$DOMAIN" \
    --key-file /etc/ssl/private/${DOMAIN}.key \
    --fullchain-file /etc/ssl/certs/${DOMAIN}.crt \
    --reloadcmd "systemctl reload nginx"

  # update nginx to listen on TLS
  BACKUP /etc/nginx/sites-available/${DOMAIN}.tls
  cat >/etc/nginx/sites-available/${DOMAIN}.tls <<EOF
server {
  listen $NGINX_HTTPS_PORT ssl http2;
  server_name $DOMAIN;
  ssl_certificate /etc/ssl/certs/${DOMAIN}.crt;
  ssl_certificate_key /etc/ssl/private/${DOMAIN}.key;

  location /xray {
    proxy_redirect off;
    proxy_pass http://127.0.0.1:$XRAY_PORT;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";
    proxy_set_header Host $host;
  }

  location /ws {
    proxy_redirect off;
    proxy_pass http://127.0.0.1:$GOST_PORT;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";
    proxy_set_header Host $host;
  }
}
EOF
  ln -sf /etc/nginx/sites-available/${DOMAIN}.tls /etc/nginx/sites-enabled/${DOMAIN}.tls
  nginx -t && systemctl reload nginx
  LOG "nginx configured with TLS for $DOMAIN"
}

# -------------------- dns (dnsmasq) or SowDNS placeholder --------------------
install_dns() {
  LOG "Installing dnsmasq"
  apt_update_install dnsmasq
  BACKUP /etc/dnsmasq.d/01-custom.conf
  cat >/etc/dnsmasq.d/01-custom.conf <<EOF
# Custom DNS records
address=/.local/127.0.0.1
EOF
  systemctl enable --now dnsmasq
  LOG "dnsmasq installed. To install SowDNS, set SOWDNS_INSTALL=true and re-run with that env var."
}

# -------------------- OpenVPN & WireGuard (community scripts interactive) --------------------
install_openvpn() {
  LOG "Installing OpenVPN community installer (interactive)"
  apt_update_install curl
  wget -O /tmp/openvpn-install.sh https://raw.githubusercontent.com/angristan/openvpn-install/master/openvpn-install.sh
  chmod +x /tmp/openvpn-install.sh
  bash /tmp/openvpn-install.sh
}
install_wireguard() {
  LOG "Installing WireGuard community installer (interactive)"
  apt_update_install curl
  wget -O /tmp/wireguard-install.sh https://raw.githubusercontent.com/Nyr/wireguard-install/master/wireguard-install.sh
  chmod +x /tmp/wireguard-install.sh
  bash /tmp/wireguard-install.sh
}

# -------------------- Entrypoint / CLI --------------------
show_help() {
  cat <<EOF
Usage: DOMAIN=example.com EMAIL=me@example.com [XRAY_UUID=...] bash $0 [--full|--ssh-ws|--xray|--nginx|--dns|--openvpn|--wg]

Options:
  --full      Run full installation: firewall + ssh/ws + xray + nginx(acme) + dns
  --ssh-ws    Install SSH, Dropbear and gost (WS)
  --xray      Install XRay core and service
  --nginx     Install nginx + acme.sh and provision TLS (requires DOMAIN & EMAIL)
  --dns       Install dnsmasq (lightweight DNS)
  --openvpn   Run OpenVPN community installer (interactive)
  --wg        Run WireGuard community installer (interactive)
  --help      Show this help
EOF
}

main() {
  require_root
  detect_os
  gen_uuid_if_empty

  if [ "$#" -eq 0 ]; then
    show_help
    echo
    echo "Running interactive full setup..."
    setup_ufw
    install_ssh_ws
    install_xray
    if [ -n "$DOMAIN" ] && [ -n "$EMAIL" ]; then
      install_nginx_and_acme
    else
      LOG "Skipping nginx/acme (DOMAIN or EMAIL missing). Run later with DOMAIN & EMAIL set."
    fi
    install_dns
    LOG "Full interactive setup finished. Review /etc/xray/config.json and nginx configs."
    exit 0
  fi

  case "$1" in
    --full)
      setup_ufw
      install_ssh_ws
      install_xray
      install_nginx_and_acme || LOG "nginx/acme skipped or failed"
      install_dns
      ;;
    --ssh-ws) install_ssh_ws ;;
    --xray) install_xray ;;
    --nginx) install_nginx_and_acme ;;
    --dns) install_dns ;;
    --openvpn) install_openvpn ;;
    --wg) install_wireguard ;;
    *) show_help ;;
  esac
}

main "$@"
